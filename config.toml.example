# Cinnabar 配置文件示例
# 任何字段都可以省略，serde 会用各字段的默认函数回填。

# 模型目录路径：
#   ./models/sherpa-onnx-x-asr-960ms-streaming-zipformer-transducer-zh-en-punct-int8-2026-06-05/
#     ├── encoder.int8.onnx       (流式 Zipformer transducer encoder, int8)
#     ├── decoder.onnx            (流式 decoder, int8 命名未带 .int8)
#     ├── joiner.int8.onnx        (流式 joiner, int8)
#     └── tokens.txt              (流式 tokens)
#   ./models/ten-vad.onnx
#   ./models/sherpa-onnx-zipformer-ctc-zh-int8-2025-07-03/
#     ├── model.int8.onnx         (非流式 Zipformer CTC, 用于精修)
#     └── tokens.txt
model_dir = "./models"

# ===== ten-vad 配置 =====
# ten-vad 模型文件路径（由 ./setup_models.sh 下载）
vad_model_path = "./models/ten-vad.onnx"

# ten-vad 语音概率阈值 0.0-1.0，越高越严格（仅在置信度高时才判为语音）。
# 与早期能量 VAD 的 0.01 不可类比 —— 现在是神经网络输出概率。
vad_threshold = 0.5

# 持续静音多久后切 segment（毫秒）
vad_min_silence_ms = 1200

# 多短的语音才视为有效 segment（毫秒）
vad_min_speech_ms = 500

# ten-vad 推理窗口大小（样本数）。16kHz 下 256 = 16ms；512 / 768 也合法。
vad_window_size = 256

# 单个 segment 最长多少秒，超过会被强制切断
vad_max_speech_duration = 20.0

# onnxruntime 推理线程数
vad_num_threads = 2

# 执行 provider（"cpu" / "cuda" / "coreml"）
vad_provider = "cpu"

# ===== 离线 ASR refine 配置 =====
# 流式 partial 立即给屏幕上的 ✅ 流式文本；VAD 切段后另启非流式 ASR
# 精修整段音频，~200ms 内覆盖该行。纯流式 → 把 enable_offline_refine
# 设为 false 即可，命令行 --no-offline-refine 也能临时关。

# 离线 Paraformer（中文 attention decoder，原生支持热词加成，223MB int8）
# 选 Paraformer 而非 Zipformer CTC / SenseVoice：
#   - attention decoder 在 beam search 阶段对热词加权（CTC 框架弱，SenseVoice 不支持）
#   - 不会过度摘要（与之前用的 Zipformer CTC 不同）
offline_model_path = "./models/sherpa-onnx-paraformer-zh-2023-09-14/model.int8.onnx"
offline_tokens_path = "./models/sherpa-onnx-paraformer-zh-2023-09-14/tokens.txt"

# 热词文件（每行一个词或短语）；空字符串 = 关闭
# ⚠️  v1.12.9 Paraformer + hotwords_file 不兼容（实现不支持 beam_search）。
#     升级到 v1.13+ 后可启用。仓库自带 docs/hotword.md（人名/地名/品牌/公司名）。
offline_hotwords_file = ""
offline_hotwords_score = 1.5  # 0.0-2.0 范围（启用热词时才生效）

# onnxruntime 推理线程数（Zipformer CTC 单线程也快，2 够用）
offline_num_threads = 2

# 执行 provider（"cpu" / "cuda" / "coreml"）
offline_provider = "cpu"

# 解码方法：v1.12.9 Paraformer 实现只支持 greedy_search（offline-recognizer-paraformer-impl.h:95）
# 升级到 v1.13+ 后可改 modified_beam_search 以支持热词加成。
offline_decoding = "greedy_search"

# 是否启用离线精修。设为 false 时退回纯流式（更省内存 / 老 CPU 推荐）。
enable_offline_refine = true

# ===== GUI 字段 =====
# 热键设置（支持 F3, F4 等）
hotkey = "F3"